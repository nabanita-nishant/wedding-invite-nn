---
import DaySchedule from '../components/DaySchedule.astro';
import Faq from '../components/Faq.astro';
import FloralMark from '../components/FloralMark.astro';
import HeartIcon from '../components/HeartIcon.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Toran from '../components/Toran.astro';
import { wedding } from '../data/wedding';
import '../styles/global.css';

const baseUrl = import.meta.env.BASE_URL;
const assetBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const storyImageUrl = `${assetBase}ChatGPT%20Image%20Nov%203,%202026,%2001_27_49%20PM.jpg`;
const { couple } = wedding;
const title = `${couple.firstName} & ${couple.secondName} | ${wedding.date}`;
const description = `Join ${couple.firstName} and ${couple.secondName} for their wedding celebrations on ${wedding.date} in ${wedding.location}.`;

const rsvpEndpoint = String(import.meta.env.PUBLIC_RSVP_ENDPOINT || wedding.rsvp.endpoint).trim();

const navLinks = [
  { href: '#welcome', label: 'Welcome' },
  { href: '#celebrations', label: 'Celebrations' },
  { href: '#rsvp', label: 'RSVP', menuOnly: true },
  { href: '#questions', label: 'Questions' },
  { href: '#contact', label: 'Contact' },
];

const petals = [
  { x: '8%', size: '11px', duration: '15s', delay: '-2s', drift: '36px' },
  { x: '22%', size: '8px', duration: '19s', delay: '-11s', drift: '-28px' },
  { x: '38%', size: '12px', duration: '17s', delay: '-6s', drift: '24px' },
  { x: '57%', size: '9px', duration: '21s', delay: '-15s', drift: '-34px' },
  { x: '74%', size: '13px', duration: '16s', delay: '-9s', drift: '30px' },
  { x: '90%', size: '9px', duration: '20s', delay: '-4s', drift: '-22px' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#511b25" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Italiana&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('reveal-on');
        window.addEventListener('load', function () {
          window.setTimeout(function () {
            if (!root.hasAttribute('data-reveal-ready')) root.classList.remove('reveal-on');
          }, 1500);
        });
      })();
    </script>
  </head>
  <body>
    <div class="doors" aria-hidden="true" data-doors>
      <div class="doors__left">
        <div class="doors__ornament">
          <FloralMark />
          <span class="doors__names">N <i>&amp;</i> N</span>
          <span class="doors__date">{wedding.date}</span>
        </div>
      </div>
      <div class="doors__right">
        <div class="doors__ornament">
          <FloralMark />
          <span class="doors__names">N <i>&amp;</i> N</span>
          <span class="doors__date">{wedding.location}</span>
        </div>
      </div>
      <button class="doors__open" type="button" data-doors-open>
        <span class="doors__open-ring"></span>
        <span class="doors__open-text">Open<br />the invite</span>
      </button>
    </div>

    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" data-header>
      <div class="site-header__inner">
        <a class="brand" href="#home" aria-label={`${couple.firstName} and ${couple.secondName}, back to top`}>
          <span class="brand__initial" aria-hidden="true">N</span>
          <span class="brand__join" aria-hidden="true">&amp;</span>
          <span class="brand__initial" aria-hidden="true">N</span>
        </a>
        <nav class="site-nav" id="site-nav" aria-label="Main" data-menu>
          {navLinks.map((link) => (
            <a class:list={['site-nav__link', { 'site-nav__link--menu-only': link.menuOnly }]} href={link.href}>
              {link.label}
            </a>
          ))}
        </nav>
        <a class="button button--light button--compact site-header__rsvp" href="#rsvp">RSVP</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
          <span class="sr-only">Menu</span>
          <span class="menu-toggle__bar" aria-hidden="true"></span>
          <span class="menu-toggle__bar" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" id="home" aria-labelledby="hero-title">
        <div class="hero__texture" aria-hidden="true"></div>
        <Toran />
        <div class="hero__petals" aria-hidden="true">
          {petals.map((petal) => (
            <span
              style={`--x: ${petal.x}; --size: ${petal.size}; --duration: ${petal.duration}; --delay: ${petal.delay}; --drift: ${petal.drift}`}
            ></span>
          ))}
        </div>
        <div class="hero__content">
          <span class="hero__arch" aria-hidden="true"></span>
          <p class="eyebrow hero__eyebrow">{wedding.hero.eyebrow}</p>
          <h1 class="hero__names" id="hero-title">
            <span>{couple.firstName}</span>
            <span class="hero__amp">&amp;</span>
            <span>{couple.secondName}</span>
          </h1>
          <p class="hero__invitation">{wedding.hero.invitation}</p>
          <div class="hero__rule" aria-hidden="true">
            <span></span>
            <FloralMark />
            <span></span>
          </div>
          <p class="hero__details">
            <span>{wedding.date}</span>
            <span class="hero__dot" aria-hidden="true"></span>
            <span>{wedding.location}</span>
          </p>
          <div class="hero__actions">
            <a class="button button--light button--shine" href="#rsvp">RSVP now</a>
            <a class="button button--ghost" href="#celebrations">View celebrations</a>
          </div>
          <p
            class="hero__countdown"
            data-countdown
            data-start={wedding.countdown.start}
            data-end={wedding.countdown.end}
            hidden
          ></p>
        </div>
        <div class="hero__side-note" aria-hidden="true">
          <span>Save the date</span>
          <span class="hero__side-line"></span>
          <span>2026</span>
        </div>
        <span class="hero__scallop" aria-hidden="true"></span>
      </section>

      <section class="welcome" id="welcome" aria-labelledby="welcome-title">
        <div class="welcome__decor" aria-hidden="true">N</div>
        <div class="container welcome__grid">
          <div class="welcome-story reveal">
            <div class="welcome-story__floral" aria-hidden="true"><FloralMark /></div>
            <figure class="welcome-story__photo">
              <img
                src={storyImageUrl}
                alt="Nabanita and Nishant walking together beneath flowering trees"
                width="1120"
                height="1536"
                loading="lazy"
              />
            </figure>
            <div class="welcome-story__card" aria-hidden="true">
              <span>A story in two chapters</span>
              <FloralMark />
              <strong>N <i>&amp;</i> N</strong>
              <small>schoolmates,<br />soulmates</small>
            </div>
          </div>
          <div class="welcome__copy reveal">
            <SectionLabel eyebrow={wedding.welcome.eyebrow} />
            <h2 class="section-title" id="welcome-title">{wedding.welcome.title}</h2>
            <p class="section-lead">{wedding.welcome.copy}</p>
            <p class="welcome__signoff">{wedding.welcome.signoff}</p>
          </div>
        </div>
      </section>

      <section class="celebrations" id="celebrations" aria-labelledby="celebrations-title">
        <div class="container">
          <div class="celebrations__intro reveal">
            <div>
              <SectionLabel eyebrow="Wedding celebrations" />
              <h2 class="sr-only" id="celebrations-title">Wedding celebrations</h2>
              <table class="mini-cal" aria-label="December 2026, first week — the 4th and 5th are wedding days" role="presentation">
                <caption class="mini-cal__caption">December 2026</caption>
                <thead>
                  <tr>
                    <th scope="col">M</th><th scope="col">T</th><th scope="col">W</th>
                    <th scope="col">T</th><th scope="col">F</th><th scope="col">S</th><th scope="col">S</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td></td>
                    <td>1</td>
                    <td>2</td>
                    <td>3</td>
                    <td><a href="#friday" class="mini-cal__hl">4</a></td>
                    <td><a href="#saturday" class="mini-cal__hl">5</a></td>
                    <td>6</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          {wedding.days.map((day) => <DaySchedule day={day} />)}

          <div class="celebrations__cta reveal">
            <p>Ready to let us know if you can make it?</p>
            <div class="celebrations__cta-actions">
              <a class="button button--ghost" href="#locations">Get the locations — view here</a>
              <a class="button button--light" href="#rsvp">RSVP now</a>
            </div>
          </div>
        </div>
      </section>

      <section class="rsvp" id="rsvp" aria-labelledby="rsvp-title">
        <div class="container rsvp__center">
          <div class="rsvp__intro reveal">
            <SectionLabel eyebrow="RSVP" />
            <h2 class="section-title" id="rsvp-title">{wedding.rsvp.title}</h2>
          </div>

          <div class="rsvp-card reveal" data-rsvp-form data-endpoint={rsvpEndpoint} data-max-plus-ones={wedding.rsvp.maxPlusOnes}>
            <span class="rsvp-card__seal" aria-hidden="true">RSVP</span>

            <div class="rsvp-step is-active" data-step="enter-name">
              <h3>Let us know you are here</h3>
              <div class="rsvp-field">
                <label class="rsvp-label" for="rsvp-name-input">Your name</label>
                <input type="text" id="rsvp-name-input" class="rsvp-input" required placeholder="Enter your full name" autocomplete="name" data-name-input>
              </div>
              <button type="button" class="button button--primary rsvp-btn-block" data-name-continue disabled>Continue</button>
            </div>

            <div class="rsvp-step" data-step="welcome">
              <p class="rsvp-greeting">Dear <strong data-rsvp-name></strong>,</p>
              <p class="rsvp-lead">You are warmly invited to our wedding celebrations.</p>
              <h3>Will you be joining us?</h3>
              <div class="rsvp-actions">
                <button type="button" class="button button--primary" data-attend="yes">Joyfully accept</button>
                <button type="button" class="button button--outline" data-attend="no">Regretfully decline</button>
              </div>
            </div>

            <div class="rsvp-step" data-step="preferences">
              <p class="rsvp-progress" data-progress></p>
              <h3>Your preferences</h3>
              <div class="rsvp-field">
                <p class="rsvp-label">Food preference</p>
                <div class="rsvp-chips">
                  <button type="button" class="rsvp-chip" data-food="vegetarian">Vegetarian</button>
                  <button type="button" class="rsvp-chip" data-food="non-vegetarian">Non-vegetarian</button>
                </div>
              </div>
              <div class="rsvp-field">
                <p class="rsvp-label">Any allergy?</p>
                <div class="rsvp-chips">
                  <button type="button" class="rsvp-chip" data-allergy="yes">Yes</button>
                  <button type="button" class="rsvp-chip" data-allergy="no">No</button>
                </div>
                <textarea class="rsvp-textarea rsvp-textarea--hidden" data-allergy-desc placeholder="Please describe your allergy (e.g., nuts, dairy, gluten)" rows="2"></textarea>
              </div>
              <button type="button" class="button button--primary rsvp-btn-block" data-pref-next disabled>Next</button>
            </div>

            <div class="rsvp-step" data-step="plusone">
              <h3>Bringing a guest?</h3>
              <p class="rsvp-note">You can add up to {wedding.rsvp.maxPlusOnes} additional guests.</p>
              <div class="rsvp-actions">
                <button type="button" class="button button--primary" data-add-guest>Yes, add a guest</button>
                <button type="button" class="button button--outline" data-skip-guests>No, that is everyone</button>
              </div>
            </div>

            <template data-guest-tpl>
              <div class="rsvp-step" data-step="guest">
                <p class="rsvp-progress" data-guest-progress></p>
                <h3>Guest <span data-guest-num></span></h3>
                <div class="rsvp-field">
                  <label class="rsvp-label" data-lbl>Name</label>
                  <input type="text" class="rsvp-input" data-g-name required placeholder="Guest's full name" autocomplete="off">
                </div>
                <div class="rsvp-field">
                  <p class="rsvp-label">Food preference</p>
                  <div class="rsvp-chips">
                    <button type="button" class="rsvp-chip" data-food="vegetarian">Vegetarian</button>
                    <button type="button" class="rsvp-chip" data-food="non-vegetarian">Non-vegetarian</button>
                  </div>
                </div>
                <div class="rsvp-field">
                  <p class="rsvp-label">Any allergy?</p>
                  <div class="rsvp-chips">
                    <button type="button" class="rsvp-chip" data-allergy="yes">Yes</button>
                    <button type="button" class="rsvp-chip" data-allergy="no">No</button>
                  </div>
                  <textarea class="rsvp-textarea rsvp-textarea--hidden" data-allergy-desc placeholder="Please describe your allergy (e.g., nuts, dairy, gluten)" rows="2"></textarea>
                </div>
                <div class="rsvp-actions">
                  <button type="button" class="button button--primary" data-save-add disabled>Add another guest</button>
                  <button type="button" class="button button--outline" data-save-done disabled>That is everyone</button>
                </div>
              </div>
            </template>

            <div class="rsvp-step" data-step="review">
              <h3>Review your RSVP</h3>
              <div class="rsvp-summary" data-summary></div>
              <div class="rsvp-actions">
                <button type="button" class="button button--primary button--shine" data-submit>Confirm RSVP</button>
              </div>
            </div>

            <div class="rsvp-step" data-step="submitting">
              <p class="rsvp-loading">Sending your RSVP&hellip;</p>
            </div>

            <div class="rsvp-step" data-step="success">
              <div class="rsvp-icon rsvp-icon--ok" aria-hidden="true">&#10003;</div>
              <h3>Thank you!</h3>
              <p>Your RSVP has been received. We cannot wait to celebrate with you!</p>
            </div>

            <div class="rsvp-step" data-step="decline">
              <h3>We will miss you</h3>
              <p>Thank you for letting us know. We hope to celebrate with you another time.</p>
              <button type="button" class="button button--primary" data-submit-decline>Send response</button>
            </div>

            <div class="rsvp-step" data-step="decline-sent">
              <div class="rsvp-icon" aria-hidden="true">&hearts;</div>
              <h3>Response sent</h3>
              <p>Thank you for letting us know.</p>
            </div>

            <div class="rsvp-step" data-step="error">
              <h3>Something went wrong</h3>
              <p>Please try again, or reach out to {wedding.contact.name} directly.</p>
              <button type="button" class="button button--primary" data-retry>Try again</button>
            </div>
          </div>
        </div>
      </section>

      <section class="faq" id="questions" aria-labelledby="faq-title">
        <div class="container faq__inner">
          <div class="faq__intro reveal">
            <SectionLabel eyebrow={wedding.faq.eyebrow} />
            <h2 class="section-title" id="faq-title">{wedding.faq.title}</h2>
            <p class="faq__lead">{wedding.faq.lead} <HeartIcon /></p>
          </div>
          <Faq items={wedding.faq.items} />
          <p class="faq__outro reveal">{wedding.faq.outro} <HeartIcon /></p>
        </div>
      </section>

      <section class="locations" id="locations" aria-labelledby="locations-title">
        <div class="container">
          <div class="locations__intro reveal">
            <SectionLabel eyebrow="Find your way" />
            <h2 class="section-title" id="locations-title">Celebration locations</h2>
            <p class="section-lead">Both venues are marked below. Open either location in Google Maps for live directions.</p>
          </div>
          <div class="locations__grid">
            {wedding.days.map((day) => (
              <article class="location-card reveal">
                <div class="location-card__map">
                  <iframe
                    src={day.venue.embedUrl}
                    title={`${day.weekday} venue map — ${day.venue.name ?? day.venue.address}`}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                  ></iframe>
                </div>
                <div class="location-card__body">
                  <p class="location-card__day">{day.weekday} · {day.shortDate}</p>
                  {day.venue.name && <h3>{day.venue.name}</h3>}
                  {day.venue.address && <p>{day.venue.address}</p>}
                  <a class="button button--primary button--compact" href={day.venue.mapUrl} target="_blank" rel="noopener noreferrer">
                    Get directions<span class="sr-only"> to the {day.weekday} venue (opens in a new tab)</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="closing" id="contact" aria-labelledby="closing-title">
        <span class="closing__scallop" aria-hidden="true"></span>
        <div class="closing__pattern" aria-hidden="true"></div>
        <div class="closing__content reveal">
          <FloralMark />
          <p class="eyebrow">Until then</p>
          <h2 id="closing-title">We cannot wait to celebrate with you.</h2>
          <p class="closing__contact">{wedding.contact.message}</p>
          <a class="button button--light" href="#rsvp">RSVP now</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>
        <span class="site-footer__names">{couple.firstName} &amp; {couple.secondName}</span>
        <span aria-hidden="true">·</span>
        {wedding.date}
        <span aria-hidden="true">·</span>
        {wedding.location}
      </p>
      <a href="#home">Back to top</a>
    </footer>

    <script>
      const root = document.documentElement;
      const header = document.querySelector<HTMLElement>('[data-header]');
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

      const setMenu = (open: boolean) => {
        menuToggle?.setAttribute('aria-expanded', String(open));
        menu?.classList.toggle('is-open', open);
        header?.classList.toggle('site-header--menu-open', open);
      };

      menuToggle?.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          menuToggle.focus();
        }
      });

      document.addEventListener('click', (event) => {
        if (header && event.target instanceof Node && !header.contains(event.target)) setMenu(false);
      });

      const countdown = document.querySelector<HTMLElement>('[data-countdown]');
      const { start, end } = countdown?.dataset ?? {};

      if (countdown && start && end) {
        const now = Date.now();
        const startsAt = new Date(start).getTime();
        const endsAt = new Date(end).getTime();
        const daysToGo = Math.ceil((startsAt - now) / 86400000);

        if (now < startsAt) {
          countdown.textContent = daysToGo === 1 ? 'Just 1 day to go' : `${daysToGo} days to go`;
          countdown.hidden = false;
        } else if (now < endsAt) {
          countdown.textContent = 'The celebrations have begun';
          countdown.hidden = false;
        }
      }

      if (window.matchMedia('(min-width: 821px)').matches) {
        document.querySelectorAll<HTMLDetailsElement>('[data-event-details]').forEach((details) => {
          details.open = true;
        });
      }

      if (root.classList.contains('reveal-on')) {
        // Mark celebrations elements for bidirectional scroll animations (entry + exit)
        document.querySelectorAll('#celebrations .reveal, #celebrations .reveal-trigger').forEach((el) => {
          el.setAttribute('data-scroll-anim', '');
        });

        // Set calendar highlight stagger delays
        document.querySelectorAll<HTMLElement>('.mini-cal__hl').forEach((hl, i) => {
          hl.style.setProperty('--cal-delay', `${300 + i * 200}ms`);
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                if (!entry.target.hasAttribute('data-scroll-anim')) {
                  observer.unobserve(entry.target);
                }
              } else if (entry.target.hasAttribute('data-scroll-anim') && entry.boundingClientRect.top > 0) {
                entry.target.classList.remove('is-visible');
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('.reveal, .reveal-trigger').forEach((element) => observer.observe(element));

        document.querySelectorAll('.timeline').forEach((tl) => {
          tl.querySelectorAll<HTMLElement>('.timeline__item').forEach((item, i) => {
            item.style.setProperty('--tl-delay', `${i * 150}ms`);
          });
        });

        root.setAttribute('data-reveal-ready', '');
      }

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const timelines = Array.from(document.querySelectorAll<HTMLElement>('.timeline'));
        timelines.forEach((timeline) => timeline.setAttribute('data-scroll-track', ''));
        let timelineFrame = 0;
        const updateTimelineMarkers = () => {
          timelineFrame = 0;
          const focus = window.innerHeight * 0.55;
          timelines.forEach((timeline) => {
            const rect = timeline.getBoundingClientRect();
            const progress = Math.min(1, Math.max(0, (focus - rect.top) / rect.height));
            const distance = Math.max(0, timeline.clientHeight - 28);
            timeline.style.setProperty('--timeline-marker-y', `${progress * distance}px`);
          });
        };
        const requestTimelineUpdate = () => {
          if (!timelineFrame) timelineFrame = requestAnimationFrame(updateTimelineMarkers);
        };
        window.addEventListener('scroll', requestTimelineUpdate, { passive: true });
        window.addEventListener('resize', requestTimelineUpdate);
        updateTimelineMarkers();
      }

      const doors = document.querySelector<HTMLElement>('[data-doors]');
      const doorsOpen = document.querySelector<HTMLButtonElement>('[data-doors-open]');

      if (doors && doorsOpen && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.body.style.overflow = 'hidden';
        doors.classList.add('doors--ready');

        const open = () => {
          doors.classList.add('doors--opening');
          document.body.style.overflow = '';
          doors.addEventListener('transitionend', () => {
            doors.remove();
          }, { once: true });
          setTimeout(() => doors.remove(), 3000);
        };

        doorsOpen.addEventListener('click', open);
        doorsOpen.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(); }
        });
      } else if (doors) {
        doors.remove();
      }

      // ── RSVP Form ──
      const rsvpForm = document.querySelector<HTMLElement>('[data-rsvp-form]');
      if (rsvpForm) {
        const ENDPOINT = rsvpForm.dataset.endpoint || '';
        const urlName = new URLSearchParams(window.location.search).get('name');
        const MAX_PLUS = Number(rsvpForm.dataset.maxPlusOnes) || 4;

        interface Guest { name: string; food: string; allergy: string; allergyDesc?: string }
        const state = { name: urlName || '', attending: true, guests: [] as Guest[] };

        const show = (step: string) => {
          rsvpForm.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => {
            const match = el.dataset.step === step;
            el.hidden = !match;
            el.classList.toggle('is-active', match);
          });
          rsvpForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        // Chip selection helper
        rsvpForm.addEventListener('click', (e) => {
          const chip = (e.target as HTMLElement).closest<HTMLElement>('.rsvp-chip');
          if (!chip) return;
          const group = chip.closest('.rsvp-chips');
          group?.querySelectorAll('.rsvp-chip').forEach((c) => c.classList.remove('is-selected'));
          chip.classList.add('is-selected');

          // Show/hide allergy description textarea
          if (chip.dataset.allergy) {
            const textarea = group?.nextElementSibling as HTMLTextAreaElement;
            if (textarea?.classList.contains('rsvp-textarea')) {
              textarea.classList.toggle('rsvp-textarea--hidden', chip.dataset.allergy === 'no');
              if (chip.dataset.allergy === 'yes') textarea.focus();
            }
          }

          // Enable next/save buttons in the same step
          const step = chip.closest<HTMLElement>('.rsvp-step');
          checkStepReady(step);
        });

        const checkStepReady = (step: HTMLElement | null) => {
          if (!step) return;
          const chips = step.querySelectorAll('.rsvp-chips');
          const allSelected = Array.from(chips).every((g) => g.querySelector('.is-selected'));
          const input = step.querySelector<HTMLInputElement>('.rsvp-input');
          const nameOk = !input || input.value.trim().length > 0;
          const allergyYes = step.querySelector('.rsvp-chip[data-allergy="yes"].is-selected');
          const allergyDesc = step.querySelector<HTMLTextAreaElement>('.rsvp-textarea');
          const allergyDescOk = !allergyYes || (allergyDesc && allergyDesc.value.trim().length > 0);
          step.querySelectorAll<HTMLButtonElement>('[data-pref-next],[data-save-add],[data-save-done]').forEach((b) => {
            b.disabled = !(allSelected && nameOk && allergyDescOk);
          });
        };

        // Name input page
        const nameInput = rsvpForm.querySelector<HTMLInputElement>('[data-name-input]');
        const nameContinue = rsvpForm.querySelector<HTMLButtonElement>('[data-name-continue]');
        nameInput?.addEventListener('input', () => {
          if (nameContinue) nameContinue.disabled = !nameInput.value.trim();
        });
        nameContinue?.addEventListener('click', () => {
          state.name = nameInput!.value.trim();
          rsvpForm.querySelector<HTMLElement>('[data-rsvp-name]')!.textContent = state.name;
          show('welcome');
        });

        // If name in URL, skip to welcome
        if (urlName) {
          rsvpForm.querySelector<HTMLElement>('[data-rsvp-name]')!.textContent = urlName;
          show('welcome');
        }

        // Add textarea input listener for preferences step
        rsvpForm.querySelector<HTMLTextAreaElement>('[data-step="preferences"] .rsvp-textarea')?.addEventListener('input', (e) => {
          const step = (e.target as HTMLElement).closest<HTMLElement>('.rsvp-step');
          checkStepReady(step);
        });

        // Attend yes/no
        rsvpForm.querySelector('[data-attend="yes"]')?.addEventListener('click', () => {
          state.attending = true;
          show('preferences');
        });
        rsvpForm.querySelector('[data-attend="no"]')?.addEventListener('click', () => {
          state.attending = false;
          show('decline');
        });

        // Preferences next
        rsvpForm.querySelector('[data-pref-next]')?.addEventListener('click', () => {
          const step = rsvpForm.querySelector<HTMLElement>('[data-step="preferences"]')!;
          const food = step.querySelector('.rsvp-chips [data-food].is-selected') as HTMLElement;
          const allergy = step.querySelector('.rsvp-chips [data-allergy].is-selected') as HTMLElement;
          const allergyDesc = step.querySelector<HTMLTextAreaElement>('.rsvp-textarea')?.value.trim() || '';
          state.guests.push({ name: state.name, food: food.dataset.food!, allergy: allergy.dataset.allergy!, allergyDesc });
          show('plusone');
        });

        // Add guest
        rsvpForm.querySelector('[data-add-guest]')?.addEventListener('click', () => spawnGuestPage());
        rsvpForm.querySelector('[data-skip-guests]')?.addEventListener('click', () => showReview());

        const spawnGuestPage = () => {
          if (state.guests.length >= MAX_PLUS + 1) { showReview(); return; }
          const tpl = rsvpForm.querySelector<HTMLTemplateElement>('[data-guest-tpl]')!;
          const frag = tpl.content.cloneNode(true) as DocumentFragment;
          const step = frag.querySelector<HTMLElement>('.rsvp-step')!;
          const num = state.guests.length + 1;
          step.dataset.step = `guest-${num}`;
          step.querySelector('[data-guest-num]')!.textContent = String(num);
          step.querySelector('[data-guest-progress]')!.textContent = `Guest ${num} of up to ${MAX_PLUS + 1}`;
          const lbl = step.querySelector('[data-lbl]') as HTMLLabelElement;
          const inp = step.querySelector<HTMLInputElement>('[data-g-name]')!;
          const id = `g-name-${num}`;
          lbl.setAttribute('for', id);
          inp.id = id;
          inp.addEventListener('input', () => checkStepReady(step));
          step.querySelector<HTMLTextAreaElement>('.rsvp-textarea')?.addEventListener('input', () => checkStepReady(step));

          step.querySelector('[data-save-add]')?.addEventListener('click', () => {
            saveGuest(step);
            spawnGuestPage();
          });
          step.querySelector('[data-save-done]')?.addEventListener('click', () => {
            saveGuest(step);
            showReview();
          });

          // Hide add-another if at limit
          if (state.guests.length >= MAX_PLUS) {
            (step.querySelector('[data-save-add]') as HTMLElement).hidden = true;
          }

          rsvpForm.querySelector<HTMLTemplateElement>('[data-guest-tpl]')!.before(step);
          show(`guest-${num}`);
        };

        const saveGuest = (step: HTMLElement) => {
          const name = step.querySelector<HTMLInputElement>('[data-g-name]')!.value.trim();
          const food = (step.querySelector('.rsvp-chips [data-food].is-selected') as HTMLElement).dataset.food!;
          const allergy = (step.querySelector('.rsvp-chips [data-allergy].is-selected') as HTMLElement).dataset.allergy!;
          const allergyDesc = step.querySelector<HTMLTextAreaElement>('.rsvp-textarea')?.value.trim() || '';
          state.guests.push({ name, food, allergy, allergyDesc });
        };

        const showReview = () => {
          const summary = rsvpForm.querySelector('[data-summary]')!;
          summary.innerHTML = state.guests.map((g, i) =>
            `<div class="rsvp-summary__row">
              <span class="rsvp-summary__name">${i === 0 ? g.name + ' (you)' : g.name}</span>
              <span class="rsvp-summary__detail">${g.food === 'vegetarian' ? 'Veg' : 'Non-veg'}${g.allergy === 'yes' ? ' · ' + (g.allergyDesc || 'Allergy') : ''}</span>
            </div>`
          ).join('');
          show('review');
        };

        // Submit
        rsvpForm.querySelector('[data-submit]')?.addEventListener('click', () => submit(true));
        rsvpForm.querySelector('[data-submit-decline]')?.addEventListener('click', () => submit(false));

        const submit = async (attending: boolean) => {
          show('submitting');
          const payload = {
            household: state.name,
            attending,
            guests: attending ? state.guests : [],
            timestamp: new Date().toISOString(),
          };
          if (!ENDPOINT) { show(attending ? 'success' : 'decline-sent'); return; }
          try {
            await fetch(ENDPOINT, {
              method: 'POST',
              headers: { 'Content-Type': 'text/plain' },
              body: JSON.stringify(payload),
              mode: 'no-cors',
            });
            show(attending ? 'success' : 'decline-sent');
          } catch {
            show('error');
          }
        };

        // Retry
        rsvpForm.querySelector('[data-retry]')?.addEventListener('click', () => show('review'));
      }
    </script>
  </body>
</html>
