---
import type { WeddingEvent } from '../data/wedding';

interface Props {
  partOfDay: WeddingEvent['partOfDay'];
}

const { partOfDay } = Astro.props;
---

<svg class="part-of-day" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {partOfDay === 'Night' && <path d="M20 14.2A8 8 0 1 1 9.8 4a6.4 6.4 0 0 0 10.2 10.2Z" />}
  {partOfDay === 'Afternoon' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" />
    </>
  )}
  {(partOfDay === 'Morning' || partOfDay === 'Evening') && (
    <>
      <path d="M3 19h18M7 19a5 5 0 0 1 10 0M4.6 13.2l1.5 1.1M19.4 13.2l-1.5 1.1M12 3v7" />
      {partOfDay === 'Morning' ? <path d="m9 6 3-3 3 3" /> : <path d="m9 7 3 3 3-3" />}
    </>
  )}
</svg>
