---
import type { WeddingEvent } from '../data/wedding';

interface Props {
  event: WeddingEvent;
}

const { event } = Astro.props;
const when = event.time ? `${event.partOfDay} · ${event.time}` : event.partOfDay;
---

<article class="event reveal" id={event.id} aria-labelledby={`${event.id}-name`}>
  <p class="event__when">{when}</p>
  <h4 class="event__name" id={`${event.id}-name`}>{event.name}</h4>
  {event.dressCode && (
    <dl class="dress">
      <div class="dress__row">
        <dt>Wear</dt>
        <dd>
          <span class="swatches" aria-hidden="true">
            {event.dressCode.wearSwatches.map((color) => <span class="swatch" style={`--swatch: ${color}`}></span>)}
          </span>
          <span>{event.dressCode.wear}</span>
        </dd>
      </div>
      {event.dressCode.avoid && (
        <div class="dress__row">
          <dt>Please avoid</dt>
          <dd>
            <span class="swatches" aria-hidden="true">
              {event.dressCode.avoidSwatches?.map((color) => <span class="swatch swatch--avoid" style={`--swatch: ${color}`}></span>)}
            </span>
            <span>{event.dressCode.avoid}</span>
          </dd>
        </div>
      )}
    </dl>
  )}
  <details class="event__details" data-event-details>
    <summary>About this celebration</summary>
    <p>{event.description}</p>
  </details>
</article>
