---
import PartOfDayIcon from './PartOfDayIcon.astro';
import type { WeddingEvent } from '../data/wedding';

interface Props {
  event: WeddingEvent;
}

const { event } = Astro.props;
const when = event.time ? `${event.partOfDay} · ${event.time}` : event.partOfDay;
const accentColors = event.dressCode?.wearSwatches ?? ['#d8bb89', '#bb8d50'];
const accentStops = accentColors.length > 1 ? accentColors : [...accentColors, ...accentColors];
---

<article
  class="event reveal"
  id={event.id}
  aria-labelledby={`${event.id}-name`}
  style={`--accent: linear-gradient(90deg, ${accentStops.join(', ')})`}
>
  <p class="event__when"><PartOfDayIcon partOfDay={event.partOfDay} />{when}</p>
  <h4 class="event__name" id={`${event.id}-name`}>{event.name}</h4>
  {event.dressCode && (
    <dl class="dress">
      <div class="dress__row">
        <dt>Wear</dt>
        <dd>
          <span class="swatches" aria-hidden="true">
            {event.dressCode.wearSwatches.map((color) => <span class="swatch" style={`--swatch: ${color}`}></span>)}
          </span>
          <span>{event.dressCode.wear}</span>
        </dd>
      </div>
      {event.dressCode.avoid && (
        <div class="dress__row">
          <dt>Please avoid</dt>
          <dd>
            <span class="swatches" aria-hidden="true">
              {event.dressCode.avoidSwatches?.map((color) => <span class="swatch swatch--avoid" style={`--swatch: ${color}`}></span>)}
            </span>
            <span>
              {event.dressCode.avoid}
              {event.dressCode.avoidReason && <span class="dress__reason">{event.dressCode.avoidReason}</span>}
            </span>
          </dd>
        </div>
      )}
    </dl>
  )}
  <details class="event__details" data-event-details>
    <summary>About this celebration</summary>
    <p>{event.description}</p>
  </details>
</article>
