---
import type { WeddingEvent } from '../data/wedding';

interface Props {
  event: WeddingEvent;
  location: {
    label: string;
    address?: string;
    mapUrl: string;
  };
}

const { event, location } = Astro.props;
---

<article class="event-card reveal">
  <div class="event-card__number">{event.number}</div>
  <div class="event-card__content">
    <div class="event-card__heading">
      <div>
        {event.time && <p class="event-card__time">{event.time}</p>}
        <h3>{event.name}</h3>
      </div>
      <span class="event-card__ornament" aria-hidden="true">&#10022;</span>
    </div>
    <p class="event-card__description">{event.description}</p>
    {event.dressCode && (
      <div class="event-card__detail">
        <span class="event-card__detail-label">Dress code</span>
        <span>{event.dressCode}</span>
      </div>
    )}
    <div class="event-card__detail event-card__detail--location">
      <span class="event-card__detail-label">{location.label}</span>
      {location.address && <span>{location.address}</span>}
      <a href={location.mapUrl} target="_blank" rel="noreferrer">View location <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</article>
