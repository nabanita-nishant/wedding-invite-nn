---
import EventCard from './EventCard.astro';
import type { WeddingDay } from '../data/wedding';

interface Props {
  day: WeddingDay;
}

const { day } = Astro.props;
---

<article class="day" id={day.id} aria-labelledby={`${day.id}-title`}>
  <header class="day__header reveal">
    <p class="day__date"><span class="day__weekday">{day.weekday}</span> {day.date}</p>
    <h3 class="day__title" id={`${day.id}-title`}>{day.title}</h3>
    <div class="venue">
      <p class="venue__label">Venue</p>
      {day.venue.name && <p class="venue__name">{day.venue.name}</p>}
      {day.venue.address && <p class="venue__address">{day.venue.address}</p>}
      <a class="button button--outline button--compact venue__map" href={day.venue.mapUrl} target="_blank" rel="noopener noreferrer">
        <svg class="venue__pin" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 21s-6.5-6.1-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.9 12 21 12 21Z" />
          <circle cx="12" cy="9.8" r="2.3" />
        </svg>
        Open in Google Maps<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </header>
  <ol class="timeline reveal-trigger">
    {day.events.map((event) => (
      <li class="timeline__item">
        <EventCard event={event} />
      </li>
    ))}
  </ol>
</article>
